MACRO tsv
  CLASS core ;
  FOREIGN tsv 0.0 0.0 ;
  ORIGIN 0 0 ;
  SYMMETRY X Y ;
  SITE TSV_SITE ;
  SIZE 30.24 BY 30.24 ;
  PIN VDD
  DIRECTION INOUT ;
  USE power ;
  SHAPE ABUTMENT ;
  PORT
    LAYER Metal1 ;
      POLYGON 0 4.59 0.245 4.59 0.245 3.55 0.475 3.55 0.475 4.59 2.24 4.59 2.24 5.49 0 5.49  ;
  END
END VDD
PIN VSS
  DIRECTION INOUT ;
  USE ground ;
  SHAPE ABUTMENT ;
  PORT
    LAYER Metal1 ;
      POLYGON 0 -0.45 2.24 -0.45 2.24 0.45 0.475 0.45 0.475 1.285 0.245 1.285 0.245 0.45 0 0.45  ;
  END
END VSS
END tsv
