 RESISTANCE 4.500 ;
 LAYER virtual_via5 ;
 RECT -0.130 -0.130 0.130 0.130 ;
 LAYER L5_h ;
 RECT -0.190 -0.130 0.190 0.130 ;
 LAYER L5_v ;
 RECT -0.190 -0.140 0.190 0.140 ;
 END virtual_via5_HH 
 
